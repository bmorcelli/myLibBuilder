#Bruce Mods to free IRAM memory
#
CONFIG_ESP32_REV_MIN_3=y
#Bruce Mods to free IRAM memory
#
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
#
CONFIG_SPIRAM_CACHE_LIBJMP_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBMATH_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBNUMPARSER_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBIO_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBTIME_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBCHAR_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBMEM_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBSTR_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBRAND_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBENV_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBFILE_IN_IRAM=n
CONFIG_SPIRAM_CACHE_LIBMISC_IN_IRAM=n
#
#Bruce Mods end
## ------ RAM MANAGEMENT (esp32s3) ------ ##
## Wi-Fi RX/TX buffer counts are pinned in the per-target defconfig.esp32s3,
## which the build applies AFTER defconfig.common. So the same overrides placed
## in defconfig.common.append were reverted here. Setting them in the esp32s3
## target append (appended to the END of defconfig.esp32s3) makes them win.
## No inline comments on CONFIG lines (breaks int parsing).

# 8 -> 4 (~1.6KB each -> ~6KB internal). Bump to 6 if Wi-Fi RX gets unstable.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
# 8 -> 4 (~6KB internal)
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
# 32 -> 16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# 16 -> 8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
# 16 -> 6 (block-ack RX window; keep <= 2*STATIC_RX + DYNAMIC_RX)
CONFIG_ESP_WIFI_RX_BA_WIN=6
## ------ END RAM MANAGEMENT (esp32s3) ------ ##
## ------ RAM MANAGEMENT ------ ##
## IMPORTANT: defconfig/Kconfig does NOT allow inline "# comments" on the same
## line as a CONFIG assignment. A trailing comment makes the value invalid
## (e.g. "3   # ...") and the option silently reverts to its Kconfig default.
## Keep every CONFIG_* on its own bare line; put notes on their own # lines.

# --- BLE controller: reserves fixed internal DMA RAM per BLE "activity" ---
# 6 -> 3 (Bruce uses 1 conn + scan/adv). Biggest single BLE saving.
CONFIG_BT_CTRL_BLE_MAX_ACT=3
# 100 -> 30 (scan duplicate-filter cache)
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=30
# 100 -> 50 (adv report flow-control buffers)
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50

# --- NimBLE host ---
# 3 -> 1 (Bruce never holds 2 BLE links at once). Must be <= BLE_MAX_ACT.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=2
# 256 -> 128 (HID/scan need little; smaller per-connection buffers)
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128
# 24 -> 12 (mbuf pool of 320B blocks: 7.7KB -> 3.8KB)
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12
# 12 -> 8
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8

# --- Wi-Fi buffers (internal on no-PSRAM boards) ---
# 8 -> 4 (~1.6KB each -> ~6KB). Biggest single Wi-Fi saving.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
# 8 -> 4 (~6KB)
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4
# 32 -> 16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
# 16 -> 8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8
# 16 -> 6 (block-ack RX window)
CONFIG_ESP_WIFI_RX_BA_WIN=6
# 32 -> 16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# --- FATFS / SD ---
# Choice: max sector 4096 -> 512. (Little effect for 512B cards, but harmless.)
# CONFIG_FATFS_SECTOR_512=y
# 255 -> 128 (long-filename work buffer; already LFN_STACK)
CONFIG_FATFS_MAX_LFN=128

# --- PSRAM boards only (no effect on cardputer / no-PSRAM) ---
# 0 -> 32K: reserve internal DRAM for Wi-Fi/BLE DMA when PSRAM is present.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
## ------ END OF RAM MANAGEMENT ------ ##

