## ------ RAM MANAGEMENT ------##
# Controller — reserva RAM interna DMA fixa por "atividade" BLE
CONFIG_BT_CTRL_BLE_MAX_ACT=3          # de 6 → 3 (Bruce usa 1 conn + scan/adv). MAIOR GANHO
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=30 # de 100 → 30 (cache anti-duplicata do scan)
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50  # de 100 → 50
# NimBLE host
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3    # de 9 - 3
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128 # de 256 → 128 (HID/scan usam pouco)
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=12 # de 24 → 12  (pool de 320B: 7.7KB → 3.8KB)
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8  # de 12 → 8
CONFIG_BT_NIMBLE_MAX_BONDS=2          # de 3 → 2
CONFIG_BT_NIMBLE_MAX_CCCDS=4          # de 8 → 4
# WIFI BUFFER STACK
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4   # de 8 → 4  (~1.6KB cada → ~6KB)
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=4   # de 8 → 4  (~6KB)
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16 # de 32 → 16
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=8    # de 16 → 8
CONFIG_ESP_WIFI_RX_BA_WIN=8              # de 16 → 6  (janela block-ack)
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16         # de 32 → 16
# FATFS FLAGS
CONFIG_FATFS_SECTOR_512=y     # de SECTOR_4096 → 512: buffer de setor 4KB → 512B (economiza ~3.5KB por buffer)
CONFIG_FATFS_MAX_LFN=128      # de 255 → 128 (nome longo; já é LFN_STACK)
# CONFIG_FATFS_PER_FILE_CACHE=n # de 1 → 0 (desliga cache de setor por arquivo; -512B por arquivo aberto, fica um pouco mais lento)
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768  # de 0 → 32K: garante bloco interno pra DMA de WiFi/BLE
## ------ END OF RAM MANAGEMENT ------ ##