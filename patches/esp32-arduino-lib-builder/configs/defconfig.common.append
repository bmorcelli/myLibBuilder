# Launcher profile: keep Wi-Fi, HTTP client/server, mDNS, OTA, FAT/SPIFFS/LittleFS
# and USB support; remove framework features not used by Launcher.
CONFIG_ARDUHAL_ESP_LOG=n
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
CONFIG_LOG_DEFAULT_LEVEL=0
# CONFIG_LOG_COLORS is not set
CONFIG_ESP_ERR_TO_NAME_LOOKUP=n
# Bluetooth is not used by Launcher. Some per-target defconfigs enable it again,
# so target append files also force it off after the original target config.
CONFIG_BT_ENABLED=n
CONFIG_BT_BLE_BLUFI_ENABLE=n
CONFIG_BLE_MESH=n
# Wired Ethernet is not used by Launcher. The base ETH component must remain
# buildable because the lib-builder still pulls LAN PHY managed components.
CONFIG_ETH_SPI_ETHERNET_DM9051=n
CONFIG_ETH_SPI_ETHERNET_W5500=n
CONFIG_ETH_SPI_ETHERNET_KSZ8851SNL=n
# Remove Wi-Fi diagnostics/features Launcher does not consume.
CONFIG_ESP_WIFI_FTM_ENABLE=n
CONFIG_ESP_WIFI_CSI_ENABLED=n
CONFIG_ESP_WIFI_GCMP_SUPPORT=n
CONFIG_ESP_MODEM_USE_PPP_MODE=n
CONFIG_LWIP_IPV6=y
CONFIG_LWIP_PPP_SUPPORT=n
# CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# CONFIG_MBEDTLS_ASYMMETRIC_CONTENT_LEN=y
# CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# CONFIG_MBEDTLS_SSL_VARIABLE_BUFFER_LENGTH=y
# FAT/exFAT: ffconf.h is patched to enable exFAT; keep LFN on heap so exFAT
# directory work does not consume extra task stack.
# CONFIG_FATFS_LFN_STACK is not set
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_ENABLE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=n
CONFIG_ESP_DEBUG_OCDAWARE=n
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=n
CONFIG_ESP_COREDUMP_ENABLE_TO_UART=y
CONFIG_ESP_COREDUMP_ENABLE_TO_NONE=n
CONFIG_ESP_COREDUMP_ENABLE=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_BIN=n
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_LOGS=n
CONFIG_ESP_COREDUMP_UART_DELAY=0
CONFIG_ESP_COREDUMP_DECODE_DISABLE=n
CONFIG_ESP_INSIGHTS_ENABLED=n
CONFIG_ENABLE_ESP_INSIGHTS_TRACE=n
# WDT disable
CONFIG_ESP_TASK_WDT=n
CONFIG_ESP_TASK_WDT_PANIC=n
# disable recovery from DeepSleep
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=n
# Partition Writer
CONFIG_SPI_FLASH_WRITING_DANGEROUS_REGIONS_ALLOWED=y
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y
