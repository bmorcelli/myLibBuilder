CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1 is not set
CONFIG_LWIP_TCP_SACK_OUT=y

CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_SDIO_BUS_WIDTH=4
CONFIG_ESP_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_SDIO_PIN_CMD=19
CONFIG_ESP_SDIO_PIN_CLK=18
CONFIG_ESP_SDIO_PIN_D0=14
CONFIG_ESP_SDIO_PIN_D1=15
CONFIG_ESP_SDIO_PIN_D2=16
CONFIG_ESP_SDIO_PIN_D3=17

# RGB Display Optimizations
CONFIG_LCD_RGB_ISR_IRAM_SAFE=y
CONFIG_LCD_RGB_RESTART_IN_VSYNC=y

CONFIG_SOC_PVT_EN_WITH_SLEEP=y
CONFIG_SOC_PVT_RETENTION_BY_REGDMA=y
CONFIG_LIBSODIUM_USE_MBEDTLS_SHA=n

CONFIG_SOC_AES_SUPPORT_PSEUDO_ROUND_FUNCTION=y
CONFIG_SOC_FLASH_ENCRYPTION_XTS_AES_SUPPORT_PSEUDO_ROUND=y
CONFIG_BOOTLOADER_RESERVE_RTC_MEM=y
CONFIG_BOOTLOADER_RESERVE_RTC_SIZE=0x10
CONFIG_ESP_TLS_USE_DS_PERIPHERAL=y
CONFIG_ESP32P4_REV_MIN_301=y
CONFIG_ESP32P4_REV_MIN_FULL=301
CONFIG_ESP_REV_MIN_FULL=301
CONFIG_P4_REV3_MSPI_CRASH_AFTER_POWER_UP_WORKAROUND=n
CONFIG_P4_REV3_MSPI_WORKAROUND_SIZE=0
CONFIG_ESP_HOSTED_WIFI_AUTO_CONNECT_ON_STA_START=y

# M5Stack Tab5 DSI framebuffer lives in PSRAM. Keep external cache available
# during flash erase/write so the DSI scanout can continue reading the frame.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
CONFIG_SPI_FLASH_PLACE_FUNCTIONS_IN_IRAM=y
CONFIG_SPI_FLASH_AUTO_CHECK_SUSPEND_STATUS=y
CONFIG_SPI_FLASH_SUSPEND_TSUS_VAL_US=50
CONFIG_SPI_FLASH_SUSPEND_TRS_VAL_US=50
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y

# Bluetooth through ESP-Hosted-MCU is not used by Launcher.
CONFIG_BT_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=n
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=n
