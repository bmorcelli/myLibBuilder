
# Bluetooth through ESP-Hosted-MCU is not used by Launcher.
CONFIG_BT_ENABLED=n
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=n
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=n

# M5Stack Tab5 DSI framebuffer lives in PSRAM. Keep external cache available
# during flash erase/write so the DSI scanout can continue reading the frame.
CONFIG_SPI_FLASH_AUTO_SUSPEND=y
CONFIG_SPI_FLASH_PLACE_FUNCTIONS_IN_IRAM=y
CONFIG_SPI_FLASH_AUTO_CHECK_SUSPEND_STATUS=y
CONFIG_SPI_FLASH_SUSPEND_TSUS_VAL_US=50
CONFIG_SPI_FLASH_SUSPEND_TRS_VAL_US=50
CONFIG_LCD_DSI_ISR_IRAM_SAFE=y

# RainMaker and Insights are not supported in this ESP32-P4 build.
CONFIG_ESP_RMAKER_SKIP_VERSION_CHECK=n
CONFIG_ESP_RMAKER_USER_ID_CHECK=n
CONFIG_ESP_INSIGHTS_ENABLED=n
CONFIG_ESP_INSIGHTS_COREDUMP_ENABLE=n
CONFIG_ESP_INSIGHTS_TRANSPORT_HTTPS=n
CONFIG_DIAG_LOG_DROP_WIFI_LOGS=n
CONFIG_DIAG_ENABLE_METRICS=n
CONFIG_DIAG_ENABLE_HEAP_METRICS=n
CONFIG_DIAG_ENABLE_WIFI_METRICS=n
CONFIG_DIAG_ENABLE_VARIABLES=n
CONFIG_DIAG_ENABLE_NETWORK_VARIABLES=n
CONFIG_DIAG_USE_EXTERNAL_LOG_WRAP=n
CONFIG_ENABLE_ESP_INSIGHTS_TRACE=n